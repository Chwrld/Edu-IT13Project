<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:utils="clr-namespace:MauiAppIT13.Utils"
             x:Class="MauiAppIT13.Pages.Student.AnnouncementsPage"
             BackgroundColor="#F5F7FA">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Top Navigation Bar -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" 
                BackgroundColor="#0891B2"
                StrokeThickness="0">
            <Grid Padding="20,0" ColumnDefinitions="Auto,*,Auto">
                <!-- Logo -->
                <HorizontalStackLayout Grid.Column="0" Spacing="10" VerticalOptions="Center">
                    <Border BackgroundColor="White" 
                            WidthRequest="32" 
                            HeightRequest="32"
                            StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8"/>
                        </Border.StrokeShape>
                        <Image Source="educrm_log.png" 
                               WidthRequest="24" 
                               HeightRequest="24"
                               Aspect="AspectFit"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </Border>
                    <Label Text="EduCRM" 
                           FontSize="18" 
                           FontAttributes="Bold"
                           TextColor="White"
                           VerticalOptions="Center"/>
                </HorizontalStackLayout>

                <!-- Network Status Indicator -->
                <ContentView Grid.Column="2"
                             BindingContext="{x:Static utils:NetworkMonitor.Instance}"
                             ControlTemplate="{StaticResource NetworkStatusBadgeTemplate}"
                             VerticalOptions="Center"
                             HorizontalOptions="End" />
            </Grid>
        </Border>

        <!-- Left Sidebar -->
        <Border Grid.Row="1" Grid.Column="0" 
                BackgroundColor="White"
                StrokeThickness="0"
                Padding="10">
            <Grid RowDefinitions="Auto,*,Auto">
                <!-- Top Menu Items -->
                <VerticalStackLayout Grid.Row="0" Spacing="5">
                    <!-- Home Menu Item -->
                    <Border BackgroundColor="Transparent" 
                            Padding="15,12"
                            StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8"/>
                        </Border.StrokeShape>
                        <HorizontalStackLayout Spacing="12">
                            <Label Text="&#xe88a;" FontFamily="MaterialIcons" FontSize="20" WidthRequest="24" HorizontalTextAlignment="Center" TextColor="#6B7280"/>
                            <Label Text="Home" 
                                   TextColor="#6B7280" 
                                   FontSize="14"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnHomeTapped"/>
                        </Border.GestureRecognizers>
                    </Border>

                    <!-- Classes Menu Item -->
                    <Border BackgroundColor="Transparent" 
                            Padding="15,12"
                            StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8"/>
                        </Border.StrokeShape>
                        <HorizontalStackLayout Spacing="12">
                            <Label Text="&#xe02f;" FontFamily="MaterialIcons" FontSize="20" WidthRequest="24" HorizontalTextAlignment="Center" TextColor="#6B7280"/>
                            <Label Text="Classes" 
                                   TextColor="#6B7280" 
                                   FontSize="14"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnClassesTapped"/>
                        </Border.GestureRecognizers>
                    </Border>

                    <!-- Messages Menu Item -->
                    <Border BackgroundColor="Transparent" 
                            Padding="15,12"
                            StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8"/>
                        </Border.StrokeShape>
                        <HorizontalStackLayout Spacing="12">
                            <Label Text="&#xe0bf;" FontFamily="MaterialIcons" FontSize="20" WidthRequest="24" HorizontalTextAlignment="Center" TextColor="#6B7280"/>
                            <Label Text="Messages" 
                                   TextColor="#6B7280" 
                                   FontSize="14"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnMessagesTapped"/>
                        </Border.GestureRecognizers>
                    </Border>

                    <!-- Announcements Menu Item (Active) -->
                    <Border BackgroundColor="#0891B2" 
                            Padding="15,12"
                            StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8"/>
                        </Border.StrokeShape>
                        <HorizontalStackLayout Spacing="12">
                            <Label Text="&#xe98e;" FontFamily="MaterialIcons" FontSize="20" WidthRequest="24" HorizontalTextAlignment="Center" TextColor="White"/>
                            <Label Text="Announcements" 
                                   TextColor="White" 
                                   FontSize="14"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Border>

                    <!-- Tickets Menu Item -->
                    <Border BackgroundColor="Transparent" 
                            Padding="15,12"
                            StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8"/>
                        </Border.StrokeShape>
                        <HorizontalStackLayout Spacing="12">
                            <Label Text="&#xe638;" FontFamily="MaterialIcons" FontSize="20" WidthRequest="24" HorizontalTextAlignment="Center" TextColor="#6B7280"/>
                            <Label Text="Tickets" 
                                   TextColor="#6B7280" 
                                   FontSize="14"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTicketsTapped"/>
                        </Border.GestureRecognizers>
                    </Border>
                </VerticalStackLayout>

                <!-- Bottom Menu Items -->
                <VerticalStackLayout Grid.Row="2" Spacing="5">
                    <!-- Profile Menu Item -->
                    <Border BackgroundColor="Transparent" 
                            Padding="15,12"
                            StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8"/>
                        </Border.StrokeShape>
                        <HorizontalStackLayout Spacing="12">
                            <Label Text="&#xe7fd;" FontFamily="MaterialIcons" FontSize="20" WidthRequest="24" HorizontalTextAlignment="Center" TextColor="#6B7280"/>
                            <Label Text="Profile" 
                                   TextColor="#6B7280" 
                                   FontSize="14"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnProfileTapped"/>
                        </Border.GestureRecognizers>
                    </Border>

                    <!-- Logout Button -->
                    <Border BackgroundColor="Transparent" 
                            Padding="15,12"
                            StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8"/>
                        </Border.StrokeShape>
                        <HorizontalStackLayout Spacing="12">
                            <Label Text="&#xe9ba;" FontFamily="MaterialIcons" FontSize="20" WidthRequest="24" HorizontalTextAlignment="Center" TextColor="#EF4444"/>
                            <Label Text="Logout" 
                                   TextColor="#EF4444" 
                                   FontSize="14"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnLogoutTapped"/>
                        </Border.GestureRecognizers>
                    </Border>
                </VerticalStackLayout>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <ScrollView Grid.Row="1" Grid.Column="1" Padding="30">
            <VerticalStackLayout Spacing="20">
                
                <!-- Page Header -->
                <VerticalStackLayout Spacing="5">
                    <Label Text="Announcements"
                           FontSize="24" 
                           FontAttributes="Bold"
                           TextColor="#2C3E50"/>
                    <Label Text="Stay updated with important information" 
                           FontSize="13" 
                           TextColor="#6B7280"/>
                </VerticalStackLayout>

                <!-- Filter Dropdown -->
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="0,10,0,0">
                    <Label Grid.Column="0" 
                           Text="Filter:" 
                           FontSize="14" 
                           TextColor="#6B7280" 
                           VerticalOptions="Center"/>
                    <Picker Grid.Column="1"
                            x:Name="FilterPicker"
                            Title="Select filter"
                            SelectedIndex="0"
                            BackgroundColor="White"
                            TextColor="#2C3E50"
                            FontSize="14"
                            HeightRequest="40"
                            SelectedIndexChanged="OnFilterChanged">
                        <Picker.Items>
                            <x:String>All</x:String>
                            <x:String>Announcements</x:String>
                        </Picker.Items>
                    </Picker>
                </Grid>

                <!-- Search Bar -->
                <Border BackgroundColor="White"
                        Padding="15,10"
                        StrokeThickness="1"
                        Stroke="#E5E7EB">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8"/>
                    </Border.StrokeShape>
                    <HorizontalStackLayout Spacing="10">
                        <Label Text="&#xe8b6;" FontFamily="MaterialIcons" FontSize="20" WidthRequest="24" HorizontalTextAlignment="Center" TextColor="#6B7280"/>
                        <Entry Placeholder="Search announcements..."
                               PlaceholderColor="#9CA3AF"
                               TextColor="#2C3E50"
                               BackgroundColor="Transparent"
                               VerticalOptions="Center"
                               HorizontalOptions="FillAndExpand"
                               TextChanged="OnSearchTextChanged"/>
                    </HorizontalStackLayout>
                </Border>

                <!-- Announcements List -->
                <CollectionView x:Name="AnnouncementsCollectionView"
                                SelectionMode="None">
                    <CollectionView.EmptyView>
                        <VerticalStackLayout Padding="20" Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                            <Label Text="No announcements yet"
                                   FontSize="14"
                                   TextColor="#6B7280"
                                   HorizontalTextAlignment="Center"/>
                            <Label Text="Check back later for new updates"
                                   FontSize="12"
                                   TextColor="#9CA3AF"
                                   HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border BackgroundColor="White"
                                    Padding="20"
                                    StrokeThickness="1"
                                    Stroke="#E5E7EB"
                                    Margin="0,0,0,15">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10"/>
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnAnnouncementTapped"
                                                          CommandParameter="{Binding .}"/>
                                </Border.GestureRecognizers>
                                <Grid RowDefinitions="Auto,Auto" RowSpacing="12">
                                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <Border WidthRequest="40"
                                                HeightRequest="40"
                                                StrokeThickness="0"
                                                BackgroundColor="#F0F9FF"
                                                VerticalOptions="Start">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="8"/>
                                            </Border.StrokeShape>
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding Visibility}" Value="students">
                                                    <Setter Property="BackgroundColor" Value="#D1FAE5"/>
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Label Text="&#xe98e;"
                                                   FontFamily="MaterialIcons"
                                                   FontSize="20"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center"
                                                   TextColor="#0891B2">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding Visibility}" Value="students">
                                                        <Setter Property="Text" Value="&#xe80c;"/>
                                                        <Setter Property="TextColor" Value="#059669"/>
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </Border>

                                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                                            <Label Text="{Binding Title}"
                                                   FontSize="16"
                                                   FontAttributes="Bold"
                                                   TextColor="#2C3E50"
                                                   LineBreakMode="WordWrap"/>
                                            <HorizontalStackLayout Spacing="8">
                                                <Label Text="{Binding AuthorName, StringFormat='By: {0}'}"
                                                       FontSize="12"
                                                       TextColor="#6B7280"/>
                                                <Label Text="•"
                                                       FontSize="12"
                                                       TextColor="#6B7280"/>
                                                <Label Text="{Binding VisibilityLabel}"
                                                       FontSize="12"
                                                       TextColor="#6B7280"/>
                                                <Label Text="•"
                                                       FontSize="12"
                                                       TextColor="#6B7280"/>
                                                <Label Text="{Binding CreatedAt, StringFormat='{}{0:MMM d, h:mm tt}'}"
                                                       FontSize="12"
                                                       TextColor="#6B7280"/>
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>

                                        <Border Grid.Column="2"
                                                BackgroundColor="#F3F4F6"
                                                Padding="10,6"
                                                StrokeThickness="0"
                                                VerticalOptions="Start">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="12"/>
                                            </Border.StrokeShape>
                                            <HorizontalStackLayout Spacing="4">
                                                <Label Text="&#xe8f4;"
                                                       FontFamily="MaterialIcons"
                                                       TextColor="#374151"
                                                       FontSize="11"
                                                       FontAttributes="Bold"
                                                       VerticalOptions="Center"/>
                                                <Label Text="{Binding ViewCount}"
                                                       TextColor="#374151"
                                                       FontSize="11"
                                                       FontAttributes="Bold"
                                                       VerticalOptions="Center"/>
                                            </HorizontalStackLayout>
                                        </Border>
                                    </Grid>

                                    <Label Grid.Row="1"
                                           Text="{Binding Content}"
                                           FontSize="14"
                                           TextColor="#4B5563"
                                           LineBreakMode="WordWrap"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Logout Confirmation Modal -->
        <Border x:Name="LogoutModal"
                Grid.RowSpan="2"
                Grid.ColumnSpan="2"
                BackgroundColor="#80000000"
                IsVisible="False">
            <Border BackgroundColor="White"
                    WidthRequest="400"
                    Padding="0"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="Black" Opacity="0.3" Radius="20" Offset="0,10"/>
                </Border.Shadow>
                <VerticalStackLayout Spacing="0">
                    <Border BackgroundColor="White" Padding="30,25" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12,12,0,0"/>
                        </Border.StrokeShape>
                        <Label Text="Logout" FontSize="20" FontAttributes="Bold" TextColor="#2C3E50"/>
                    </Border>
                    <VerticalStackLayout Padding="30,25" Spacing="25" BackgroundColor="White">
                        <Label Text="Are you sure you want to logout?" FontSize="15" TextColor="#4B5563" HorizontalTextAlignment="Center"/>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="15">
                            <Button Grid.Column="0" 
                                    x:Name="LogoutYesButton"
                                    Text="Yes" 
                                    BackgroundColor="#EF4444" 
                                    TextColor="White" 
                                    FontAttributes="Bold" 
                                    CornerRadius="8" 
                                    Padding="0" 
                                    HeightRequest="44"
                                    Clicked="OnLogoutConfirmed"/>
                            <Button Grid.Column="1" 
                                    x:Name="LogoutNoButton"
                                    Text="No" 
                                    BackgroundColor="#E5E7EB" 
                                    TextColor="#2C3E50" 
                                    FontAttributes="Bold" 
                                    CornerRadius="8" 
                                    Padding="0" 
                                    HeightRequest="44"
                                    Clicked="OnLogoutCancelled"/>
                        </Grid>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
        </Border>

    </Grid>
</ContentPage>
